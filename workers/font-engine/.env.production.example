CONTROL_API_BASE_URL=https://<production-domain>
WORKER_SHARED_SECRET=<same-production-secret-as-web>
WORKER_STORAGE_DRIVER=vercel
BLOB_READ_WRITE_TOKEN=<same-production-private-blob-token>
WORKER_RUNTIME_DIR=/tmp/handfont-worker
VERCEL_QUEUE_REGION=icn1
VERCEL_QUEUE_TOPIC=handfont-production-jobs
QUEUE_CONSUMER_GROUP=font-engine-production-v1
QUEUE_DRIVER=vercel

# Shared
APP_BASE_URL=http://localhost:3000
WORKER_SHARED_SECRET=replace-with-at-least-32-random-characters

# Web / Vercel
DATABASE_URL=postgresql://handfont:handfont@localhost:5432/handfont
STORAGE_DRIVER=local
NEXT_PUBLIC_STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
QUEUE_DRIVER=local
VERCEL_QUEUE_REGION=icn1
VERCEL_QUEUE_TOPIC=handfont-jobs
LOCAL_BLOB_DIR=../../runtime/blob
MAX_UPLOAD_BYTES=26214400

# Worker
CONTROL_API_BASE_URL=http://localhost:3000
WORKER_STORAGE_DRIVER=local
WORKER_BLOB_DIR=../../runtime/blob
WORKER_RUNTIME_DIR=../../worker-runtime
QUEUE_CONSUMER_GROUP=font-engine-v1
POLL_INTERVAL_SECONDS=2

# Preview 전용: Production 값과 분리하십시오.
DATABASE_URL=postgresql://preview-user:preview-password@preview-host/handfont_preview
WORKER_SHARED_SECRET=<preview-random-secret-at-least-32-characters>
STORAGE_DRIVER=vercel
NEXT_PUBLIC_STORAGE_DRIVER=vercel
BLOB_READ_WRITE_TOKEN=<preview-private-blob-token>
QUEUE_DRIVER=vercel
VERCEL_QUEUE_REGION=icn1
VERCEL_QUEUE_TOPIC=handfont-preview-jobs
MAX_UPLOAD_BYTES=26214400

# Production 전용: Preview 값과 분리하십시오.
DATABASE_URL=postgresql://production-user:production-password@production-host/handfont
WORKER_SHARED_SECRET=<production-random-secret-at-least-32-characters>
STORAGE_DRIVER=vercel
NEXT_PUBLIC_STORAGE_DRIVER=vercel
BLOB_READ_WRITE_TOKEN=<production-private-blob-token>
QUEUE_DRIVER=vercel
VERCEL_QUEUE_REGION=icn1
VERCEL_QUEUE_TOPIC=handfont-production-jobs
MAX_UPLOAD_BYTES=26214400
